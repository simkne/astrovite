---
import BaseLayout from '@/layouts/BaseLayout.astro'
import siteConfig from '@/site-config'
import { BASE_PATH, withBase } from '@/site-config'
---

<BaseLayout description={siteConfig.description}>
  <article class="prose">
    <h1 class="text-title">hi.</h1>
    <p>
      This is my personal wiki and build log — a place where I collect what I learn, break, and figure out along the
      way. Most of it revolves around <strong>embedded systems</strong>, <strong>home automation</strong>,
      <strong>AI tooling</strong>, and the <strong>web stack</strong> that ties it all together.
    </p>

    <p>
      <img
        width="640"
        height="360"
        src={withBase(siteConfig.image?.src || 'imgs/hero01.png')}
        alt={siteConfig.image?.alt || 'Hero image'}
      />
    </p>

    <h2>What’s inside</h2>
    <ul>
      <li>
        <strong>ESP32 & IoT</strong> — firmware, sensors, wireless protocols, and the rough edges nobody documents.
      </li>
      <li>
        <strong>openHAB</strong> — rules, bindings, persistence, and making a smart home actually
        <em>smart</em>.
      </li>
      <li>
        <strong>AI & Development</strong> — prompting strategies, local LLMs, agents, and the code that glues them to real-world
        problems.
      </li>
      <li>
        <strong>Web & Architecture</strong> — Astro, Vue, APIs, and the tooling that keeps this site (and my side projects)
        running.
      </li>
    </ul>

    <h2>Where to start</h2>
    <ul>
      <li>
        <a prose-link href={withBase('/projects')}>Projects</a>
        <span op-60> — deep dives into builds, from schematic to deployment.</span>
      </li>
      <li>
        <a prose-link href={withBase('/blog')}>Blog</a>
        <span op-60> — longer write-ups, opinions, and lessons learned the hard way.</span>
      </li>
      <li>
        <a prose-link href={withBase('/blog/notes')}>Notes</a>
        <span op-60> — quick reference, snippets, and the “how did I do that again?” archive.</span>
      </li>
    </ul>

    <p>
      Found a bug, have a better approach, or just want to argue about tabs vs spaces? Hit me at
      <a prose-link aria-label={siteConfig.email} href={`mailto:${siteConfig.email}`}>
        {siteConfig.email}
      </a>.
    </p>
  </article>
</BaseLayout>
