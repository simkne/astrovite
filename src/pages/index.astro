---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ListProjects from '@/components/ListProjects.vue'
import siteConfig from '@/site-config'
import { withBase } from '@/site-config'
import { getPosts } from '@/utils/posts'
import ContactBox from '@/components/ContactBox.astro'

const latest = (await getPosts()).slice(0, 2)
const latestEntries = latest.map((entry, i) => ({
  text: entry.data.title,
  description: entry.data.description,
  href: `/posts/${entry.id}/`,
  icon: i === 0 ? 'i-arcticons-brain-test' : 'i-arcticons-brain-test',
}))

const startBlocks = [
  {
    icon: 'i-arcticons-spacenow',
    title: 'Projects',
    text: 'Deep dives into builds, from schematic to deployment.',
    href: '/projects/',
  },
  {
    icon: 'i-arcticons-mind-space',
    title: 'Blog',
    text: 'Longer write-ups, opinions, and lessons learned the hard way.',
    href: '/blog/',
  },
  {
    icon: 'i-arcticons:atom-meditation',
    title: 'Notes',
    text: 'Quick reference, snippets, and the “how did I do that again?” archive.',
    href: '/blog/notes/',
  },
]
---

<BaseLayout description={siteConfig.description}>
  <article class="prose">
    <header class="hero">
      <h1 class="home-title">hi.</h1>
      <p class="hero-lead">
        I’m Simon. This is my personal wiki and build log — where I collect what I learn, break, and figure out along
        the way.
      </p>
      <p class="hero-sub">
        <strong>Embedded systems</strong> · <strong>home automation</strong> · <strong>AI tooling</strong> · <strong
          >the web stack</strong
        >
      </p>
    </header>

    <h2>Where to start</h2>
    <div class="cards not-prose" role="list">
      {
        startBlocks.map((block) => (
          <a class="card" role="listitem" href={withBase(block.href)}>
            <i class={`${block.icon} card-icon`} data-icon={block.icon} />
            <div>
              <h3 class="card-title">{block.title}</h3>
              <p class="card-text">{block.text}</p>
            </div>
          </a>
        ))
      }
    </div>

    <h2>Latest entries</h2>
    <ListProjects list={latestEntries} />

    <p class="closing">
      Found a bug, have a better approach, or just want to argue about tabs vs spaces?
      <ContactBox />
      <span class="note">Work in progress — sometimes it really is just nonsense.</span>
    </p>
  </article>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 2.5rem;
  }

  .hero .home-title {
    margin-bottom: 0.2em;
  }

  .hero-lead {
    font-size: 1.075rem;
    max-width: 60ch;
    margin-bottom: 0.4rem;
  }

  .hero-sub {
    opacity: 0.7;
    max-width: 60ch;
    margin-top: 0.4rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0 0 2.5rem;
  }

  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    background: color-mix(in srgb, currentColor 4%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    text-decoration: none;
    opacity: 0.72;
    transition:
      opacity 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
  }

  .card:hover {
    opacity: 1;
    border-color: color-mix(in srgb, currentColor 32%, transparent);
    background: color-mix(in srgb, currentColor 8%, transparent);
    transform: translateY(-3px);
  }

  .card-icon {
    font-size: 4.2rem;
    line-height: 1;
    opacity: 0.85;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.2rem;
  }

  .card-text {
    font-size: 0.9rem;
    line-height: 1.5;
    opacity: 0.75;
    margin: 0;
    text-wrap: auto;
  }

  .closing {
    margin-top: 2.75rem;
  }

  .note {
    display: block;
    margin-top: 0.85rem;
    font-size: 0.8rem;
    font-style: italic;
    opacity: 0.5;
  }
</style>
