---
import { render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import ContentHero from '@/components/ContentHero.astro'
import EditLink from '@/components/EditLink.vue'
import PrivateGate from '@/components/blog/PrivateGate.vue'
import { withBase } from '@/site-config'
import { type CollectionPosts } from '@/types'
import { getPosts, getTags } from '@/utils/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => {
    return {
      params: { slug: post.id },
      props: {
        post,
      },
    }
  })
}

type Props = { post: CollectionPosts }

const { post } = Astro.props
const { title, image, description, date, duration, private: isPrivate, sharePassword } = post.data
const tags = getTags(post)

const { Content } = await render(post)

function getDate(date: string) {
  return new Date(date).toISOString()
}
---

<BaseLayout title={title} description={description} image={image} pageType="article">
  <article class="prose">
    <h1>{title}</h1>
    <p op-50>
      {date && <time datetime={getDate(date)}>{date.split(',')}</time>}
      {duration && <span>· {duration}</span>}
      {
        tags.length > 0 && (
          <span>
            ·
            {tags.map((tag, i) => (
              <a nav-link href={withBase(`/blog/tag/${encodeURIComponent(tag)}/`)}>
                #{tag}
                {i < tags.length - 1 ? ', ' : ''}
              </a>
            ))}
          </span>
        )
      }
    </p>
    <ContentHero image={image} />
    <PrivateGate client:load private={isPrivate} sharePassword={sharePassword} slug={post.id}>
      <Content />
    </PrivateGate>
    <EditLink client:load path={`src/content/blog/${post.id}.md`} />
  </article>
</BaseLayout>
