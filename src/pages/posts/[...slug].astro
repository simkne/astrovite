---
import { render } from 'astro:content'
import { Picture } from 'astro:assets'
import BaseLayout from '@/layouts/BaseLayout.astro'
import EditLink from '@/components/EditLink.vue'
import PrivateGate from '@/components/blog/PrivateGate.vue'
import { withBase } from '@/site-config'
import { resolveAsset } from '@/lib/images'
import { type CollectionPosts } from '@/types'
import { getPosts, getTags } from '@/utils/posts'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((post) => {
    return {
      params: { slug: post.id },
      props: {
        post,
      },
    }
  })
}

type Props = { post: CollectionPosts }

const { post } = Astro.props
const { title, image, description, date, duration, private: isPrivate, sharePassword } = post.data
const tags = getTags(post)

const { Content } = await render(post)

const headerAsset = image?.src ? resolveAsset(image.src) : undefined

function getDate(date: string) {
  return new Date(date).toISOString()
}
---

<BaseLayout title={title} description={description} image={image} pageType="article">
  <article class="prose">
    <h1>{title}</h1>
    <p op-50>
      {date && <time datetime={getDate(date)}>{date.split(',')}</time>}
      {duration && <span>· {duration}</span>}
      {
        tags.length > 0 && (
          <span>
            ·
            {tags.map((tag, i) => (
              <a nav-link href={withBase(`/blog/tag/${encodeURIComponent(tag)}/`)}>
                #{tag}
                {i < tags.length - 1 ? ', ' : ''}
              </a>
            ))}
          </span>
        )
      }
    </p>
    {
      headerAsset && (
        <p>
          <Picture
            src={headerAsset}
            formats={['avif', 'webp']}
            widths={[480, 640, 960]}
            sizes="(min-width: 768px) 640px, 100vw"
            alt={image?.alt || ''}
            class="rd-2"
            loading="lazy"
          />
        </p>
      )
    }
    {
      image && !headerAsset && (
        <p>
          <img width="640" height="360" src={withBase(image.src)} alt={image.alt || ''} />
        </p>
      )
    }
    <PrivateGate client:load private={isPrivate} sharePassword={sharePassword} slug={post.id}>
      <Content />
    </PrivateGate>
    <EditLink client:load path={`src/content/blog/${post.id}.md`} />
  </article>
</BaseLayout>
