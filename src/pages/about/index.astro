---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ContactBox from '@/components/ContactBox.astro'
import { Image } from 'astro:assets'
import siteConfig from '@/site-config'
import logo from '@/assets/imgs/noesi-logo.png'

const placeholderBlocks = [
  {
    icon: 'i-ri-user-heart-line',
    title: 'hi, I’m SimKne',
    text: 'A short intro about who I am, what I do, and what this site is about. This is placeholder copy.',
  },
  {
    icon: 'i-ri-code-box-line',
    title: 'What I build',
    text: 'Embedded systems, IoT, web apps, and everything in between. Placeholder for a real summary.',
  },
  {
    icon: 'i-ri-sun-line',
    title: 'Beyond the code',
    text: 'A bit about hobbies, interests, or whatever makes the person behind the projects tick.',
  },
]
---

<BaseLayout title="About" description={`About ${siteConfig.author} — a placeholder introduction.`} pageType="website">
  <article class="not-prose">
    <!-- Hero -->
    <div class="flex flex-col items-center gap-6 mb-14 mt-2">
      <Image
        width={120}
        height={120}
        densities={[1, 2]}
        format="webp"
        class="rounded-full border border-main !border-op-40 object-cover"
        src={logo}
        alt={siteConfig.header.logo.alt}
      />
      <div class="text-center">
        <h3 class="home-title mb-2">what's this all about?</h3>
        <p class="opacity-70 max-w-xl mx-auto">
          {siteConfig.subtitle} - webdevelopment and personal views on the world.
        </p>
      </div>
    </div>

    <!-- Intro -->
    <div class="mb-14">
      <h2 class="text-xl font-700 mb-4 flex items-center gap-2">
        <i class="i-ri-hand-heart-line text-2xl"></i>
        A quick introduction
      </h2>
      <p class="opacity-80 leading-7">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. This is placeholder text for a short personal
        introduction. It will describe what I care about, why I run this site, and what readers can expect to find here.
      </p>
      <p class="opacity-80 leading-7 mt-4">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore
        magna aliqua.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-14">
      {
        placeholderBlocks.map((block) => (
          <div class="container-link rounded-lg border border-main !border-op-20 bg-main p-6 flex flex-col gap-3 transition-all hover:!border-op-50">
            <i class={`${block.icon} text-3xl opacity-70`} />
            <h3 class="font-700 text-lg">{block.title}</h3>
            <p class="opacity-70 text-sm leading-6">{block.text}</p>
          </div>
        ))
      }
    </div>

    <!-- Experience placeholder -->
    <div class="mb-14">
      <h2 class="text-xl font-700 mb-6 flex items-center gap-2">
        <i class="i-ri-file-list-3-line text-2xl"></i>
        Experience
      </h2>
      <ol class="flex flex-col gap-6 border-l border-main !border-op-30 pl-6">
        <li>
          <div class="opacity-50 text-sm mb-1">2025 — Present · SnoreFree GmbH</div>
          <div class="font-600">Tech Lead, DCTO</div>
          <p class="opacity-70 text-sm mt-1 leading-6">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        </li>
        <li>
          <div class="opacity-50 text-sm mb-1">2022 — 2025 · Freelance</div>
          <div class="font-600">Freelance Developer</div>
          <p class="opacity-70 text-sm mt-1 leading-6">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        </li>
        <li>
          <div class="opacity-50 text-sm mb-1">2019 — 2020 · Addendum.org</div>
          <div class="font-600">frontend developer</div>
          <p class="opacity-70 text-sm mt-1 leading-6">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        </li>
        <li>
          <div class="opacity-50 text-sm mb-1">2017 — 2018 · nexxar.com</div>
          <div class="font-600">frontend developer</div>
          <p class="opacity-70 text-sm mt-1 leading-6">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        </li>
      </ol>
    </div>

    <!-- Contact -->
    <ContactBox />
  </article>
</BaseLayout>
