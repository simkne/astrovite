---
import { withBase } from '@/site-config'

interface NavLink {
  text: string
  href: string
}

interface Props {
  links: NavLink[]
}

const { links } = Astro.props

function normalize(path: string) {
  return path.replace(/\/+/g, '/').replace(/\/$/, '')
}

/** Exact match, or longest prefix so section tabs stay active on nested articles. */
function activeLink(href: string) {
  const current = normalize(Astro.url.pathname)
  const target = normalize(withBase(href))
  const matches = links
    .map((link) => normalize(withBase(link.href)))
    .filter((t) => current === t || current.startsWith(`${t}/`))
    .sort((a, b) => b.length - a.length)

  return matches[0] === target
}
---

<div class="flex flex-col gap-2 sm:flex-row sm:gap-4 flex-wrap mb-8">
  {
    links.map((nav) => (
      <a
        aria-label={nav.text}
        class={`nav-link text-3xl font-bold ${activeLink(nav.href) ? 'opacity-80' : 'opacity-30 hover:opacity-50'}`}
        href={withBase(nav.href)}
      >
        {nav.text}
      </a>
    ))
  }
</div>
