---
import { withBase } from '@/site-config'
import { isActiveHref } from '@/utils/nav'

interface NavLink {
  text: string
  href: string
}

interface Props {
  links: NavLink[]
}

const { links } = Astro.props
---

<div class="flex flex-col gap-2 sm:flex-row sm:gap-4 flex-wrap mb-8">
  {
    links.map((nav) => (
      <a
        aria-label={nav.text}
        class={`nav-link text-3xl font-bold ${isActiveHref(nav.href, links, Astro.url.pathname) ? 'opacity-80' : 'opacity-30 hover:opacity-50'}`}
        href={withBase(nav.href)}
      >
        {nav.text}
      </a>
    ))
  }
</div>
