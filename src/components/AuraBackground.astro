---
// Pure-CSS animated aura background — rendered on every page.
// Sits between the body background/dot grid and the DotBackground canvas
// (canvas is fixed z-0, this layer is fixed z--1).

interface Props {
  violet?: string
  cyan?: string
  pink?: string
}

const { violet, cyan, pink } = Astro.props

// only render custom vars that are actually set — an empty inline custom property
// would otherwise resolve to the @property initial-value (transparent) instead of
// falling back to the CSS light/dark defaults.
const auraStyle = [violet && `--aura-violet:${violet}`, cyan && `--aura-cyan:${cyan}`, pink && `--aura-pink:${pink}`]
  .filter(Boolean)
  .join(';')
---

<div class="aura" aria-hidden="true" transition:persist="aura" style={auraStyle || undefined}>
  <div class="blob blob-violet"></div>
  <div class="blob blob-cyan"></div>
  <div class="blob blob-pink"></div>
</div>

<style>
  .aura {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    --aura-opacity: 0.6;
    --aura-blur: 70px;
    /* transition is OFF until the first sync — otherwise the blobs animate from
       the @property initial-value (transparent) on every fresh page load */
    transition: none;
  }

  /* enabled after initial sync so only cross-page palette changes fade in */
  .aura--ready {
    transition:
      --aura-violet 2.5s ease-in-out,
      --aura-cyan 2.5s ease-in-out,
      --aura-pink 2.5s ease-in-out;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(var(--aura-blur));
    will-change: transform;
  }

  .blob-violet {
    width: 55vw;
    height: 55vw;
    top: -15vw;
    left: -10vw;
    background: radial-gradient(circle at 35% 35%, var(--aura-violet), transparent 70%);
    opacity: var(--aura-opacity);
    animation: aura-drift-a 12s ease infinite alternate;
  }

  .blob-cyan {
    width: 45vw;
    height: 45vw;
    top: 20vh;
    right: -12vw;
    background: radial-gradient(circle at 60% 40%, var(--aura-cyan), transparent 70%);
    opacity: var(--aura-opacity);
    animation: aura-drift-b 10s ease infinite alternate;
  }

  .blob-pink {
    width: 50vw;
    height: 50vw;
    bottom: -18vw;
    left: 15vw;
    background: radial-gradient(circle at 45% 55%, var(--aura-pink), transparent 72%);
    opacity: calc(var(--aura-opacity) * 0.9);
    animation: aura-drift-c 14s ease infinite alternate;
  }

  @keyframes aura-drift-a {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(8vw, 6vh) scale(1.15);
    }
  }

  @keyframes aura-drift-b {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(-7vw, 10vh) scale(0.9);
    }
  }

  @keyframes aura-drift-c {
    from {
      transform: translate(0, 0) scale(1) rotate(0deg);
    }
    to {
      transform: translate(-5vw, -8vh) scale(1.2) rotate(25deg);
    }
  }

  :global(html:not(.dark)) .aura {
    --aura-violet: hsl(258 75% 74%);
    --aura-cyan: hsl(190 85% 72%);
    --aura-pink: hsl(330 75% 76%);
  }

  :global(html.dark) .aura {
    --aura-opacity: 0.55;
    --aura-violet: hsl(258 85% 62%);
    --aura-cyan: hsl(190 100% 58%);
    --aura-pink: hsl(330 82% 62%);
  }

  @media (max-width: 640px) {
    .aura {
      --aura-blur: 50px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
    }
  }
</style>

<script>
  // The aura persists across Astro view-transition navigations (transition:persist),
  // but the browser resets the CSS animation clock when the node is moved. Re-anchor
  // each blob's animation to wall-clock time so the drift is continuous between pages.
  // Cycle = 2 × duration (position pattern repeats every full back-and-forth).
  const CYCLES = [24000, 20000, 28000] // ms — 2 × the 12s/10s/14s drift durations

  function syncAura() {
    const blobs = document.querySelectorAll('.aura .blob')
    blobs.forEach((el, i) => {
      const anim = el.getAnimations().find((a) => a.animationName?.startsWith('aura-drift'))
      if (anim) {
        anim.currentTime = performance.now() % (CYCLES[i] ?? 24000)
      }
    })
  }

  // Apply the current page's custom aura palette (set on <body> via BaseLayout) to the
  // persisted .aura node. Registering vars with @property lets the change transition in.
  function syncColors() {
    const aura = document.querySelector('.aura')
    if (!aura) {
      return
    }
    const body = document.body
    const values = [
      ['--aura-violet', body.dataset.auraViolet],
      ['--aura-cyan', body.dataset.auraCyan],
      ['--aura-pink', body.dataset.auraPink],
    ] as const
    for (const [prop, value] of values) {
      if (value && value.trim()) {
        aura.style.setProperty(prop, value)
        continue
      }
      aura.style.removeProperty(prop)
    }
  }

  function sync() {
    syncAura()
    syncColors()
    // enable the color transition after the first sync: on initial load the palette
    // is already correct (transition would cause a transparent→color flash); from now
    // on any change (navigation) fades smoothly.
    const aura = document.querySelector('.aura')
    if (aura) {
      aura.classList.add('aura--ready')
    }
  }

  // `astro:after-swap` fires synchronously right after the DOM swap — changing the
  // colors in that same tick means the browser batches old+new into one style recalc
  // and the CSS transition is skipped (jump). Defer one frame so the persisted node
  // first gets its "before" palette computed, then the change animates smoothly.
  document.addEventListener('astro:after-swap', () => {
    requestAnimationFrame(sync)
  })
  sync()
</script>
