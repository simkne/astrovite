---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import { resolveAsset } from '@/lib/images'
import { withBase } from '@/site-config'

interface Props {
  src: ImageMetadata | string
  alt: string
  title: string
  description?: string
  /** vertical focus of the crop, 0 (top) – 100 (bottom). default 38. */
  focusY?: number
}

const { src: rawSrc, alt, title, description, focusY = 38 } = Astro.props
const asset = typeof rawSrc === 'string' ? resolveAsset(rawSrc) : rawSrc
const fallbackSrc = typeof rawSrc === 'string' ? withBase(rawSrc) : rawSrc.src
---

<section class="hero" aria-label={alt}>
  {
    asset ? (
      <Picture
        src={asset}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="100vw"
        alt={alt}
        class="hero-img"
        loading="eager"
        fetchpriority="high"
        data-focus-y={focusY}
        style={`object-position: center ${focusY}%`}
      />
    ) : (
      <img
        class="hero-img"
        src={fallbackSrc}
        alt={alt}
        width="1600"
        height="900"
        data-focus-y={focusY}
        style={`object-position: center ${focusY}%`}
        loading="eager"
      />
    )
  }
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-overlay">
    <h1 class="hero-title">{title}</h1>
    {description && <p class="hero-desc">{description}</p>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 45vh;
    /* break out of the max-w-3xl column to span the viewport (no transform —
       a transform ancestor would become the containing block for the fixed pin) */
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-bottom: 3rem;
    border-radius: 1rem;
    overflow: hidden;
  }

  .hero :global(picture),
  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero :global(picture) {
    display: block;
  }

  .hero :global(.hero-img) {
    object-fit: cover;
    object-position: center 38%;
    /* fade the top edge of the image into the page background */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, black 58%);
    mask-image: linear-gradient(to bottom, transparent 0, black 58%);
  }

  /* subtle bottom scrim so the overlaid title stays readable */
  .hero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgb(238 245 252 / 0.72), transparent 48%);
  }

  :global(html.dark) .hero-scrim {
    background: linear-gradient(to top, rgb(0 0 0 / 0.6), transparent 48%);
  }

  .hero-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem 2rem 1.75rem;
    color: #484848;
  }

  :global(html.dark) .hero-overlay {
    color: #fff;
  }

  .hero-title {
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin: 0;
    text-shadow: 0 1px 2px rgb(255 255 255 / 0.55);
  }

  :global(html.dark) .hero-title {
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.45);
  }

  /* Save energy: static, in-flow hero image with no parallax, scrim, mask or glow. */
  html.save-energy .hero {
    position: relative;
    height: auto;
    width: 100%;
    margin-left: 0;
    margin-bottom: 2.5rem;
    border-radius: 0;
    overflow: visible;
    aspect-ratio: 16 / 9;
  }

  html.save-energy .hero :global(picture),
  html.save-energy .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 1rem;
    overflow: hidden;
  }

  html.save-energy .hero :global(.hero-img) {
    object-fit: cover;
    object-position: center 38%;
    -webkit-mask-image: none;
    mask-image: none;
  }

  html.save-energy .hero-scrim {
    display: none;
  }

  html.save-energy .hero-overlay {
    position: static;
    padding: 1rem 0 0;
    color: #ffffff;
  }

  html.save-energy .hero-title {
    text-shadow: none;
  }

  .hero-desc {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0.92;
    max-width: 60ch;
  }
</style>

<script>
  // Parallax: the image is pinned fixed at the hero's own position from the very
  // start, so it never scrolls up with the page — content merely passes over it
  // while it fades out, and the visible crop drifts slowly downward (a subtle
  // counter-scroll touch achieved by shifting the object-position).
  // Active in both light and dark; disabled in save-energy mode.
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
  let ticking = false
  let raf = 0
  let listenersAttached = false

  function isSaveEnergy() {
    return document.documentElement.classList.contains('save-energy')
  }

  function active() {
    return !isSaveEnergy() && !reducedMotion.matches
  }

  function resetStyles(el: HTMLElement | null) {
    if (!el) {
      return
    }
    el.style.position = ''
    el.style.top = ''
    el.style.left = ''
    el.style.right = ''
    el.style.bottom = ''
    el.style.width = ''
    el.style.height = ''
    el.style.margin = ''
    el.style.zIndex = ''
    el.style.opacity = ''
    el.style.overflow = ''
  }

  function cleanup() {
    const img = document.querySelector('.hero-img')
    if (!img) {
      return
    }
    const hero = img.closest('.hero')
    if (!hero) {
      return
    }
    const scrim = hero.querySelector('.hero-scrim')
    const picture = img.parentElement?.tagName === 'PICTURE' ? img.parentElement : null
    resetStyles((picture || img) as HTMLElement)
    resetStyles(scrim as HTMLElement)
    img.style.objectPosition = ''
  }

  function update() {
    ticking = false
    if (!active()) {
      cleanup()
      return
    }
    const img = document.querySelector('.hero-img')
    if (!img || !img.parentElement) {
      return
    }
    const hero = img.closest('.hero')
    if (!hero) {
      return
    }
    const scrim = hero.querySelector('.hero-scrim')
    // pin the image together with its bottom scrim so the dark fade under the
    // title stays glued to the image instead of scrolling away from it
    const picture = img.parentElement?.tagName === 'PICTURE' ? img.parentElement : null
    const elements = [picture || img, scrim].filter(Boolean) as HTMLElement[]

    // document-space top of the hero is constant, so the pinned image keeps the
    // exact position it had at rest (no movement up, no jump at any threshold)
    const pinTop = hero.getBoundingClientRect().top + window.scrollY
    const scrollY = window.scrollY
    const fade = window.innerHeight * 0.6
    const opacity = String(Math.max(0, 1 - scrollY / fade))
    // slow, capped drift: showing a higher crop makes the image content appear
    // to slide downward inside the fixed window
    const delta = Math.min(scrollY * 0.02, 11)
    const baseY = Number(img.dataset.focusY ?? 38)
    img.style.objectPosition = `center ${Math.max(0, baseY - delta)}%`

    for (const el of elements) {
      el.style.position = 'fixed'
      el.style.top = `${pinTop}px`
      el.style.left = '0'
      el.style.right = 'auto'
      el.style.bottom = 'auto'
      el.style.width = '100vw'
      el.style.height = '45vh'
      el.style.margin = '0'
      el.style.zIndex = '-1'
      el.style.opacity = opacity
      el.style.overflow = 'hidden'
    }
  }

  function requestUpdate() {
    if (!ticking) {
      ticking = true
      raf = requestAnimationFrame(update)
    }
  }

  function attach() {
    if (listenersAttached) {
      return
    }
    listenersAttached = true
    window.addEventListener('scroll', requestUpdate, { passive: true })
    window.addEventListener('resize', requestUpdate, { passive: true })
    document.addEventListener('astro:page-load', requestUpdate)
  }

  function detach() {
    if (!listenersAttached) {
      return
    }
    listenersAttached = false
    window.removeEventListener('scroll', requestUpdate)
    window.removeEventListener('resize', requestUpdate)
    document.removeEventListener('astro:page-load', requestUpdate)
    if (raf) {
      cancelAnimationFrame(raf)
      raf = 0
    }
    ticking = false
    cleanup()
  }

  function sync() {
    if (active()) {
      attach()
      requestUpdate()
    }
    if (!active()) {
      detach()
    }
  }

  sync()
  new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })
  if (reducedMotion.addEventListener) {
    reducedMotion.addEventListener('change', sync)
  }
</script>
