---
interface Props {
  src: string
  alt: string
  title: string
  description?: string
}

const { src, alt, title, description } = Astro.props
---

<section class="hero" aria-label={alt}>
  <img class="hero-img" src={src} alt={alt} width="1600" height="900" />
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="hero-overlay">
    <h1 class="hero-title">{title}</h1>
    {description && <p class="hero-desc">{description}</p>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* break out of the max-w-3xl column to span the viewport */
    width: 100vw;
    left: 50%;
    transform: translateX(-50%);
    margin: 0 0 2.5rem;
    border-radius: 1rem;
    overflow: hidden;
  }

  .hero-img {
    display: block;
    width: 100%;
    height: 45vh;
    object-fit: cover;
    object-position: center 38%;
    /* fade the top edge of the image into the page background */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, black 58%);
    mask-image: linear-gradient(to bottom, transparent 0, black 58%);
  }

  /* subtle bottom scrim so the overlaid title stays readable */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.6), transparent 48%);
  }

  .hero-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem 2rem 1.75rem;
    color: #fff;
  }

  .hero-title {
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.1;
    margin: 0;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.45);
  }

  .hero-desc {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0.92;
    max-width: 60ch;
  }
</style>
