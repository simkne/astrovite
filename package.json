{
  "name": "astro-theme-vitesse",
  "type": "module",
  "version": "1.3.1",
  "description": "A minimal, SEO-friendly portfolio and blog theme for Astro, supports Vue and UnoCSS.",
  "author": "Kieran Wong <kieranwme@gmail.com> (https://github.com/kieranwv/)",
  "license": "MIT",
  "keywords": [
    "kieranwong9865",
    "astro-theme-vitesse",
    "astro",
    "blog",
    "starter",
    "template"
  ],
  "engines": {
    "node": ">=v18.17.1 || >=v20.3.0 || >=21"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.0",
    "@astrojs/vue": "^7.0.1",
    "@fontsource/dm-mono": "^5.3.0",
    "@unocss/astro": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "astro": "^7.1.6",
    "marked": "^18.0.10",
    "nprogress": "^0.2.0",
    "sharp": "^0.35.4",
    "unocss": "^66.7.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@iconify/json": "^2.2.327",
    "@types/lodash-es": "^4.17.12",
    "@types/nprogress": "^0.2.3",
    "@vueuse/core": "^13.1.0",
    "bumpp": "^10.1.0",
    "eslint": "^9.24.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-format": "^1.0.1",
    "lint-staged": "^15.5.1",
    "lodash-es": "^4.17.21",
    "prettier-plugin-astro": "^0.14.1",
    "simple-git-hooks": "^2.12.1",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,astro,vue,json,md}": "eslint --fix"
  }
}
